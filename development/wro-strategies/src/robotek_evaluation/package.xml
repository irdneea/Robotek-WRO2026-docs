<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotek_evaluation</name>
  <version>0.1.0</version>
  <description>Simulation-only evaluation: ground-truth audit recorders, actuator model, rule judge, round reports and experiment runners. Strategies must not depend on it.</description>
  <maintainer email="user@example.com">coach</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>python3-numpy</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <depend>robotek_open</depend>
  <depend>robotek_obstacle</depend>
  <exec_depend>robotek_gazebo</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
