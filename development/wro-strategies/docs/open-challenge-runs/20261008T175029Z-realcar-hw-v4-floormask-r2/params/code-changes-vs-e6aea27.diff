+
+
+def _stall(machine, controller, seconds):
+    p = SimpleNamespace(front=1.0, front_axis=1.5, corner_distance=float('inf'), corner=False,
+                        side_open=False, inner=0.5, left=0.5, right=0.5, outer=0.5,
+                        visual_direction=0, direction_hint=0, visual_age=0.0,
+                        wall_valid=True, wall_yaw=0.0, endpoint_confirmed=False)
+    for _ in range(int(seconds / 0.02)):
+        machine.step(0.02, p, controller, 0.0)
+    return machine.state
+
+
+@pytest.mark.parametrize('limit,final', [(0, 'RECOVER'), (1, 'STALLED')])
+def test_repeated_stall_without_progress_stops_for_good(limit, final):
+    from robotek_open.open_config import config_with
+    cfg = config_with(direction='ccw', stall_max_recoveries=limit)
+    machine = OpenStateMachine(cfg)
+    machine.state = State.FOLLOW
+    controller = OpenController(cfg)
+    machine.recoveries = 0
+    assert _stall(machine, controller, 2.2) is State.RECOVER       # first stall: back off
+    machine.state = State.FOLLOW                                    # recovery ended, no progress
+    state = _stall(machine, controller, 2.2)
+    assert state.name == final
+    if final == 'STALLED':
+        assert machine.step(0.02, None, controller, 0.0)[:2] == (0.0, 0.0)
