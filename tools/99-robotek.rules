# udev rules of the Robotek car: stable device names and permissions for the dialout group.
# tools/setup-pi.sh installs them as /etc/udev/rules.d/99-robotek.rules. To do it by hand:
#   sudo cp tools/99-robotek.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# Your user has to be in the groups dialout, video and gpio (setup-pi.sh does it) and log in again.
#
# Where each identifier comes from:
#  * 1a86:55d4  Hiwonder RRC Lite board (shows up as /dev/ttyACM0). It is the same identifier as Hiwonder MentorPi's
#               99-ttyACM0.rules and as the team's own measurements (README of robotek_hardware).
#  * 10c4:ea60  CP210x USB-serial adapter of the LDROBOT LD19 LiDAR (shows up as /dev/ttyUSB0). It is the one in the
#               ldlidar.rules of LDROBOT's repository (src/ldlidar_stl_ros2/scripts/ldlidar.rules). Careful: any other
#               generic CP210x device (10c4:ea60) will also be named /dev/ldlidar.
#  * gpiochip   the GPIO rule gives the gpio group access to /dev/gpiochip* (used by the push button and by the old
#               TB6612 motor driver through lgpio). It is the usual Raspberry Pi rule and has not been checked on a clean
#               Pi: if a node says "GPIO chip not usable", look here first.
#  * The USB camera (icSpring, 32e6:9005, used on earlier versions) needs no rule: the video group is enough.

# RRC Lite board: /dev/rrc_lite (and keep ModemManager away from it)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", GROUP="dialout", MODE="0660", SYMLINK+="rrc_lite", ENV{ID_MM_PORT_IGNORE}="1"

# LD19 LiDAR: /dev/ldlidar
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", GROUP="dialout", MODE="0660", SYMLINK+="ldlidar", ENV{ID_MM_PORT_IGNORE}="1"

# GPIO
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", GROUP="gpio", MODE="0660"
